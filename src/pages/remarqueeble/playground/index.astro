---
import BaseLayout from '../../../components/BaseLayout.astro'
import { site } from '../../../data/site'
import '../../../assets/css/demo.css'
import '../../../lib/lite.css'
---

<BaseLayout
	title="Playground"
	description={site.description}
	path="/remarqueeble/playground/"
	bodyClass="demo-page"
	mainClass="playground-layout"
	showHeader={false}>
	<header class="playground-header">
		<hgroup>
			<h1>
				<a href="/remarqueeble/" aria-labelledby="site-title-readable">
					<span id="site-title-readable" class="sr-only">
						<mark>{site.readableTitle}</mark>
					</span>
					<mark aria-hidden="true">{site.title}</mark>
				</a>
			</h1>
			<h2>playground</h2>
		</hgroup>

		<nav aria-label="Playground navigation">
			<ul>
				<li><a role="button" href="/remarqueeble/">Back</a></li>
				<li><button type="button" data-reset>Reset</button></li>
				<li>
					<button type="button" data-fullscreen>Full Screen</button>
				</li>
			</ul>
		</nav>
	</header>

	<section
		id="playground-display"
		class="playground-display"
		aria-labelledby="display-heading">
		<h1 id="display-heading" class="sr-only">Playground</h1>
		<div class="preview-stage" data-preview></div>
		<div class="code-preview">
			<div class="code-preview-header">
				<strong>Code</strong>
				<button type="button" data-copy>Copy</button>
			</div>
			<code-viewer></code-viewer>
		</div>
		<div class="code-preview events-preview">
			<div class="code-preview-header">
				<strong>Events</strong>
			</div>
			<pre
				class="astro-code"><code data-events-output>// waiting for marquee events</code></pre>
		</div>
	</section>

	<section class="playground-controls" aria-label="Playground controls">
		<form data-playground>
			<details open>
				<summary>Show</summary>

				<div class="checkbox-list" role="group" aria-label="Show previews">
					<label class="checkbox-control">
						<input name="show-re-marquee" type="checkbox" checked />
						<span><code>&lt;re-marquee&gt;</code> Custom Element</span>
					</label>

					<label class="checkbox-control">
						<input name="show-lite" type="checkbox" />
						<span><code>.re-marquee</code> Lite CSS Class</span>
					</label>

					<label class="checkbox-control">
						<input name="show-marquee" type="checkbox" />
						<span><code>&lt;marquee&gt;</code> Native Element</span>
					</label>
				</div>
			</details>

			<details open>
				<summary>Playback</summary>

				<label>
					<span><code>animate</code></span>
					<select name="animate">
						<option value="always">always</option>
						<option value="overflow">overflow</option>
						<option value="never">never</option>
					</select>
				</label>

				<label>
					<span><code>behavior</code></span>
					<select name="behavior">
						<option value="scroll">scroll</option>
						<option value="alternate">alternate</option>
						<option value="slide">slide</option>
					</select>
				</label>

				<label>
					<span><code>direction</code></span>
					<select name="direction">
						<option value="left">left</option>
						<option value="right">right</option>
						<option value="up">up</option>
						<option value="down">down</option>
					</select>
				</label>

				<label>
					<span><code>loop</code></span>
					<input name="loop" type="number" min="-1" step="1" placeholder="-1" />
				</label>
			</details>

			<details open data-section="speed">
				<summary>Speed</summary>

				<div data-section-body="speed">
					<label>
						<span><code>scrollamount</code></span>
						<input
							data-setting-control="range"
							name="scrollamountRange"
							type="range"
							min="0"
							max="30"
							step="1"
							value="6"
						/>
						<input
							data-setting-control="number"
							name="scrollamount"
							type="text"
							inputmode="text"
							value="6"
						/>
					</label>

					<label>
						<span><code>scrolldelay</code></span>
						<input
							data-setting-control="range"
							name="scrolldelayRange"
							type="range"
							min="0"
							max="500"
							step="5"
							value="85"
						/>
						<input
							data-setting-control="number"
							name="scrolldelay"
							type="number"
							min="0"
							max="500"
							step="5"
							value="85"
						/>
					</label>

					<label class="checkbox-control">
						<input name="truespeed" type="checkbox" />
						<span><code>truespeed</code></span>
					</label>
				</div>

				<p class="section-note" data-section-note="speed" hidden>
					Only available with <code>&lt;re-marquee&gt;</code> or <code
						>&lt;marquee&gt;</code
					>.
				</p>
			</details>

			<details data-section="lite-css">
				<summary>Lite CSS</summary>

				<div data-section-body="lite-css">
					<label>
						<span><code>--re-marquee-duration</code></span>
						<input
							data-setting-control="range"
							name="durationRange"
							type="range"
							min="1"
							max="60"
							step="1"
							value="20"
						/>
						<input
							data-setting-control="number"
							name="duration"
							type="number"
							min="1"
							max="60"
							step="1"
							value="20"
						/>
					</label>
				</div>

				<p class="section-note" data-section-note="lite-css" hidden>
					Only available with <code>.re-marquee</code>.
				</p>
			</details>

			<details>
				<summary>Box</summary>

				<label>
					<span><code>width</code></span>
					<input name="width" type="text" value="100%" />
				</label>

				<label>
					<span><code>height</code></span>
					<input name="height" type="text" value="" placeholder="auto" />
				</label>

				<label>
					<span><code>bgcolor</code></span>
					<input
						data-color-hex
						name="bgcolor"
						inputmode="text"
						maxlength="6"
						pattern="[0-9a-fA-F]{3}|[0-9a-fA-F]{6}"
						spellcheck="false"
						type="text"
						value=""
						placeholder="transparent"
					/>
					<input data-color-picker="bgcolor" type="color" value="#000000" />
				</label>

				<label>
					<span><code>hspace</code></span>
					<input name="hspace" type="text" value="" placeholder="0" />
				</label>

				<label>
					<span><code>vspace</code></span>
					<input name="vspace" type="text" value="" placeholder="0" />
				</label>
			</details>

			<details>
				<summary>Style</summary>

				<label>
					<span>Font Size (px)</span>
					<input
						name="fontSize"
						type="number"
						min="8"
						max="96"
						step="1"
						value=""
						placeholder="16"
					/>
				</label>

				<label>
					<span>Colour</span>
					<input
						data-color-hex
						name="color"
						inputmode="text"
						maxlength="6"
						pattern="[0-9a-fA-F]{3}|[0-9a-fA-F]{6}"
						spellcheck="false"
						type="text"
						value=""
						placeholder="currentColor"
					/>
					<input data-color-picker="color" type="color" value="#000000" />
				</label>
			</details>

			<details>
				<summary>Content</summary>

				<label>
					<textarea name="content" rows="4"></textarea>
				</label>
			</details>
		</form>
	</section>

	<Fragment slot="scripts">
		<script src="../../../assets/js/demo.js"></script>
	</Fragment>
</BaseLayout>
