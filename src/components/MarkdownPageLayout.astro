---
import BaseLayout from './BaseLayout.astro'

interface Props {
	title?: string
	description?: string
	path?: string
	bodyClass?: string
	mainClass?: string
}

const { title, description, path, bodyClass, mainClass } = Astro.props as Props
---

<BaseLayout {title} {description} {path} {bodyClass} {mainClass}>
	<slot />
</BaseLayout>
